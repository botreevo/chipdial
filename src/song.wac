// chipdial's song: one song, one dial from chill (0) to intense (1). `src/app.wac` plays it in a page.
//
// Every musical feature is a function of the smoothed intensity `t`. Nothing switches: a layer
// or a drum hit has a threshold and fades in over a short span of `t` above it, and the drum
// and bass patterns only ever gain hits as `t` rises, so the groove builds instead of reshuffling.
import { math } from "core";

// Eight bars, one chord a bar, four notes each (MIDI), voiced around middle C.
static i32[] CHORDS = [
  57, 60, 64, 67,   // Am7
  53, 57, 60, 64,   // Fmaj7
  55, 59, 60, 64,   // Cmaj7
  55, 59, 62, 67,   // G
  57, 60, 64, 67,   // Am7
  57, 60, 62, 65,   // Dm7
  53, 57, 60, 64,   // Fmaj7
  56, 59, 62, 64,   // E7
];
static i32[] ROOTS = [45, 41, 48, 43, 45, 38, 41, 40];

// Per-step thresholds: a hit on that step begins at this intensity. 2.0 is never.
static f64[] KICK  = [0.45, 2.0, 2.0, 0.95, 2.0, 2.0, 0.85, 2.0, 0.52, 2.0, 0.75, 2.0, 2.0, 2.0, 0.9, 2.0];
static f64[] SNARE = [2.0, 2.0, 2.0, 2.0, 0.6, 2.0, 2.0, 0.97, 2.0, 2.0, 2.0, 2.0, 0.6, 2.0, 2.0, 0.92];
static f64[] HAT   = [0.5, 0.72, 0.38, 0.8, 0.5, 0.7, 0.38, 0.82, 0.5, 0.74, 0.38, 0.78, 0.5, 0.7, 0.38, 0.76];
static f64[] BASS  = [0.25, 2.0, 2.0, 0.66, 2.0, 2.0, 0.45, 2.0, 0.32, 2.0, 0.5, 0.82, 0.62, 2.0, 0.55, 0.88];
static i32[] BASS_OFS = [0, 0, 0, 12, 0, 0, 12, 0, 0, 0, 7, 12, 0, 0, 12, 7];
// Arpeggio: index into the chord, four per octave, up and back down.
static i32[] ARP = [0, 1, 2, 3, 4, 5, 6, 7, 6, 5, 4, 3, 2, 3, 4, 5];
// A minor pentatonic for the lead; the E7 bar swaps G for G#.
static i32[] SCALE    = [57, 60, 62, 64, 67, 69, 72, 74, 76, 79, 81];
static i32[] SCALE_E7 = [57, 59, 62, 64, 68, 69, 71, 74, 76, 80, 81];

export struct Part {
  f64 phase = 0.0;
  f64 freq = 110.0;
  f64 env = 0.0;      // the envelope, jumped to 1 on a hit and decaying
  f64 amp = 0.0;      // the envelope as applied, a millisecond behind so a retrigger cannot click
  f64 decay = 0.999;  // per-sample multiplier
  f64 vel = 0.0;
  f64 lp = 0.0;
  f64 lp2 = 0.0;
}

export struct Song {
  f64 rate = 48000.0;
  f64 t = 0.0;
  f64 tCoef = 0.0;
  f64 stepPos = 0.999;
  i32 step = -1;
  u32 rng = 0x9E3779B9;
  f64[] freqs;
  f64[] padPh;
  f64[] padFreq;
  f64[] padTarget;
  f64 padL1 = 0.0;
  f64 padL2 = 0.0;
  f64 padR1 = 0.0;
  f64 padR2 = 0.0;
  Part arp;
  Part bass;
  Part lead;
  Part kick;
  Part snare;
  Part hat;
  f64 kickPitch = 0.0;
  f64 leadTarget = 440.0;
  i32 leadIdx = 5;
  f64 lfo = 0.0;
  f64[] dl;
  f64[] dr;
  i32 dpos = 0;
  i32 dlen = 1;
  f64 dlp = 0.0;
  f64[] outL;
  f64[] outR;
  f64 meter = 0.0;
  /** Each layer's loudest envelope since `levels` last read them: what the page draws for a chunk. */
  f64[] peaks;
}

f64 clamp01(f64 x) { return x < 0.0 ? 0.0 : (x > 1.0 ? 1.0 : x); }

/** 0 below `a`, 1 above `b`, an S-curve between. */
f64 ss(f64 a, f64 b, f64 x) {
  f64 u = clamp01((x - a) / (b - a));
  return u * u * (3.0 - 2.0 * u);
}

f64 lerp(f64 a, f64 b, f64 u) { return a + (b - a) * u; }

f64 tri(f64 ph) { return 4.0 * (ph - 0.5).abs() - 1.0; }
f64 pulse(f64 ph, f64 duty) { return ph < duty ? 1.0 : -1.0; }

/** A parabola per half-cycle: close enough to a sine for a kick drum. */
f64 sine(f64 ph) {
  if (ph < 0.5) { return 16.0 * ph * (0.5 - ph); }
  return 0.0 - 16.0 * (ph - 0.5) * (1.0 - ph);
}

f64 wrap(f64 ph) { return ph >= 1.0 ? ph - ph.floor() : ph; }

/** One-pole low-pass coefficient for a cutoff in Hz. */
f64 lpc(f64 hz, f64 rate) {
  f64 a = 6.283185307179586 * hz / rate;
  return a > 1.0 ? 1.0 : a;
}

/** A seconds-long exponential decay as a per-sample multiplier (to about -60 dB). */
f64 decayFor(f64 seconds, f64 rate) { return math.exp(0.0 - 6.9 / (seconds * rate)); }

u32 hash(i32 x) {
  u32 h = (x as@ u32) * (2654435761 as u32);
  h ^= h >> (15 as u32);
  h *= (2246822519 as u32);
  h ^= h >> (13 as u32);
  return h;
}

f64 noise(Song s) {
  s.rng ^= s.rng << (13 as u32);
  s.rng ^= s.rng >> (17 as u32);
  s.rng ^= s.rng << (5 as u32);
  return (s.rng as f64) / 2147483648.0 - 1.0;
}

void hit(Part v, f64 vel, f64 decay) {
  if (vel <= 0.0) { return; }
  v.env = 1.0;
  v.vel = vel;
  v.decay = decay;
}

f64 envelope(Part v) {
  v.env *= v.decay;
  v.amp += (v.env - v.amp) * 0.02;
  return v.amp * v.vel;
}

f64 osc(Part v, f64 rate) {
  v.phase = wrap(v.phase + v.freq / rate);
  return v.phase;
}

export Song create(f64 rate, i32 block) {
  Song s = Song { };
  s.rate = rate;
  s.tCoef = 1.0 - math.exp(0.0 - 1.0 / (0.4 * rate));
  s.freqs = f64[].filled(128, 0.0);
  for (i32 n = 0; n < 128; n++) { s.freqs[n] = 440.0 * math.pow(2.0, ((n - 69) as f64) / 12.0); }
  s.padPh = f64[].filled(8, 0.0);
  s.padFreq = f64[].filled(8, 0.0);
  s.padTarget = f64[].filled(8, 0.0);
  for (i32 k = 0; k < 8; k++) {
    s.padPh[k] = (k as f64) * 0.137;
    s.padFreq[k] = s.freqs[CHORDS[k % 4]];
    s.padTarget[k] = s.padFreq[k];
  }
  s.dlen = (rate * 0.45).floor() as~ i32;
  s.dl = f64[].filled(s.dlen, 0.0);
  s.dr = f64[].filled(s.dlen, 0.0);
  s.outL = f64[].filled(block, 0.0);
  s.outR = f64[].filled(block, 0.0);
  s.peaks = f64[].filled(7, 0.0);
  return s;
}

/** Start where the dial is rather than gliding up from zero. */
export void jump(Song s, f64 t) { s.t = clamp01(t); }

void onStep(Song s) {
  s.step++;
  i32 st = s.step % 16;
  i32 bar = (s.step / 16) % 8;
  f64 t = s.t;
  f64 r = s.rate;

  if (st == 0) {
    // Chord change: the pad glides to the new voicing, one detuned pair per note.
    for (i32 k = 0; k < 4; k++) {
      f64 f = s.freqs[CHORDS[bar * 4 + k]];
      s.padTarget[k] = f * 0.998;
      s.padTarget[k + 4] = f * 1.002;
    }
  }

  // Drums. The span a hit fades in over is short, so it arrives quickly but not as a pop.
  f64 kg = ss(KICK[st], KICK[st] + 0.1, t);
  if (kg > 0.0) { hit(s.kick, kg, decayFor(0.4, r)); s.kickPitch = 1.0; }
  hit(s.snare, ss(SNARE[st], SNARE[st] + 0.1, t), decayFor(lerp(0.25, 0.16, t), r));
  f64 accent = st % 4 == 2 ? 1.0 : 0.7;
  bool open = st == 14 && t > 0.8;
  hit(s.hat, ss(HAT[st], HAT[st] + 0.1, t) * accent, decayFor(open ? 0.18 : 0.045, r));

  // Bass: long and soft when it is alone, short and punchy once the drums are in.
  f64 bg = ss(BASS[st], BASS[st] + 0.1, t);
  if (bg > 0.0) {
    s.bass.freq = s.freqs[ROOTS[bar] + (t > 0.5 ? BASS_OFS[st] : 0)];
    hit(s.bass, bg, decayFor(lerp(1.6, 0.28, ss(0.25, 0.7, t)), r));
  }

  // Arpeggio: eighths first, then the sixteenths between them.
  f64 ag = ss(0.1, 0.28, t);
  if (st % 2 == 1) { ag *= ss(0.45, 0.65, t); }
  if (ag > 0.0) {
    i32 a = ARP[st];
    s.arp.freq = s.freqs[CHORDS[bar * 4 + a % 4] + 12 * (a / 4) + 12];
    hit(s.arp, ag, decayFor(lerp(0.5, 0.18, t), r));
  }

  // Lead: a walk on the pentatonic, reset every four bars so each phrase is the same phrase
  // every time round. It is walked whether or not it is audible, so it never depends on the dial.
  i32 phrase = (s.step / 64) % 4;
  if (st == 0 && bar % 4 == 0) { s.leadIdx = 5; }
  u32 h = hash(phrase * 1000 + (bar % 4) * 16 + st);
  bool onset = st == 0 || (st % 2 == 0 && h % (100 as u32) < (40 as u32)) || (st == 3 && h % (7 as u32) == (0 as u32));
  if (onset) {
    s.leadIdx += ((h >> (8 as u32)) % (5 as u32)) as@ i32 - 2;
    if (s.leadIdx < 2) { s.leadIdx = 3; }
    if (s.leadIdx > 10) { s.leadIdx = 9; }
    s.leadTarget = s.freqs[bar == 7 ? SCALE_E7[s.leadIdx] : SCALE[s.leadIdx]];
    hit(s.lead, ss(0.7, 0.85, t), decayFor(0.9, r));
  }
}

export void render(Song s, f64 target, i32 n) {
  f64 r = s.rate;
  target = clamp01(target);
  for (i32 i = 0; i < n; i++) {
    s.t += (target - s.t) * s.tCoef;
    f64 t = s.t;

    f64 bpm = 82.0 + 46.0 * t;
    s.stepPos += bpm * 4.0 / 60.0 / r;
    if (s.stepPos >= 1.0) { s.stepPos -= 1.0; onStep(s); }

    // Pad: eight triangles, the detuned halves split left and right, through two poles.
    f64 padA = 0.0;
    f64 padB = 0.0;
    for (i32 k = 0; k < 8; k++) {
      s.padFreq[k] += (s.padTarget[k] - s.padFreq[k]) * 0.0004;
      s.padPh[k] = wrap(s.padPh[k] + s.padFreq[k] / r);
      if (k < 4) { padA += tri(s.padPh[k]); } else { padB += tri(s.padPh[k]); }
    }
    f64 pc = lpc(300.0 + 3200.0 * t * t, r);
    s.padL1 += (padA * 0.25 - s.padL1) * pc;
    s.padL2 += (s.padL1 - s.padL2) * pc;
    s.padR1 += (padB * 0.25 - s.padR1) * pc;
    s.padR2 += (s.padR1 - s.padR2) * pc;
    f64 padGain = 0.3 * (1.0 - 0.35 * t);

    // Arp: the pulse narrows and the filter opens as it heats up.
    f64 ae = envelope(s.arp);
    peak(s, 1, ae);
    f64 av = pulse(osc(s.arp, r), 0.5 - 0.35 * t) * ae;
    s.arp.lp += (av - s.arp.lp) * lpc(900.0 + 5000.0 * t, r);
    f64 arp = s.arp.lp * 0.11;

    // Bass: triangle, with a square mixed in as the intensity rises.
    f64 bph = osc(s.bass, r);
    f64 be = envelope(s.bass);
    peak(s, 2, be);
    f64 bv = (tri(bph) * (1.0 - 0.6 * t) + pulse(bph, 0.5) * 0.6 * t) * be;
    s.bass.lp += (bv - s.bass.lp) * lpc(300.0 + 1500.0 * t, r);
    s.bass.lp2 += (s.bass.lp - s.bass.lp2) * lpc(300.0 + 1500.0 * t, r);
    f64 bass = s.bass.lp2 * 0.34;

    // Kick: a sine whose pitch falls.
    s.kickPitch *= 0.9993;
    s.kick.freq = 46.0 + 140.0 * s.kickPitch * s.kickPitch;
    f64 ke = envelope(s.kick);
    peak(s, 4, ke);
    f64 kick = sine(osc(s.kick, r)) * ke * 0.6;

    // Snare and hat: noise, high-passed by subtracting a low-passed copy.
    f64 nz = noise(s);
    f64 se = envelope(s.snare);
    peak(s, 5, se);
    s.snare.lp += (nz - s.snare.lp) * lpc(1200.0, r);
    s.snare.freq = 185.0;
    f64 snare = ((nz - s.snare.lp) * 0.8 + sine(osc(s.snare, r)) * se) * se * 0.26;
    s.hat.lp += (nz - s.hat.lp) * lpc(6000.0, r);
    f64 he = envelope(s.hat);
    peak(s, 3, he);
    f64 hat = (nz - s.hat.lp) * he * 0.09;

    // Lead: a square with a little glide and vibrato.
    s.lfo = wrap(s.lfo + 5.2 / r);
    s.lead.freq += (s.leadTarget - s.lead.freq) * 0.004;
    s.lead.phase = wrap(s.lead.phase + s.lead.freq * (1.0 + 0.004 * tri(s.lfo)) / r);
    f64 le = envelope(s.lead);
    peak(s, 6, le);
    f64 lv = pulse(s.lead.phase, 0.25) * le;
    s.lead.lp += (lv - s.lead.lp) * lpc(3500.0, r);
    f64 lead = s.lead.lp * 0.085;

    // Ping-pong echo on the arp and lead, darkened on every pass.
    f64 send = arp * 0.55 + lead * 0.5 + snare * 0.12;
    f64 echoL = s.dl[s.dpos];
    f64 echoR = s.dr[s.dpos];
    s.dlp += (echoR - s.dlp) * 0.35;
    s.dl[s.dpos] = send + s.dlp * 0.42;
    s.dr[s.dpos] = echoL * 0.42;
    s.dpos++;
    if (s.dpos >= s.dlen) { s.dpos = 0; }

    f64 mid = bass + kick + snare * 0.9;
    f64 left = s.padL2 * padGain + mid + arp * 0.8 + lead * 0.6 + hat * 0.65 + echoL * 0.45;
    f64 right = s.padR2 * padGain + mid + arp * 0.5 + lead * 0.8 + hat * 0.9 + echoR * 0.45;
    f64 master = 1.7 - 0.55 * t;
    s.outL[i] = soft(left * master);
    s.outR[i] = soft(right * master);
    s.meter += ((left * left + right * right) - s.meter) * 0.0005;
  }
}

/** A rational tanh: gentle, and never past ±1. */
f64 soft(f64 x) {
  if (x > 3.0) { return 1.0; }
  if (x < -3.0) { return -1.0; }
  return x * (27.0 + x * x) / (27.0 + 9.0 * x * x);
}

export i32 step(Song s) { return s.step; }
export f64 intensity(Song s) { return s.t; }

/**
 * How loud each layer has been since this was last asked, 0 to about 1, into `out` (seven of them): pad, arp, bass,
 * hats, kick, snare, lead — what the page draws for a chunk. The pad is its gain; the rest are the loudest each
 * envelope got, so a kick that came and went inside the chunk still shows.
 */
export void levels(Song s, f64[] out) {
  out[0] = 1.0 - 0.35 * s.t;
  for (i32 k = 1; k < 7; k++) {
    out[k] = s.peaks[k];
    s.peaks[k] = 0.0;
  }
}

void peak(Song s, i32 k, f64 v) { if (v > s.peaks[k]) { s.peaks[k] = v; } }
